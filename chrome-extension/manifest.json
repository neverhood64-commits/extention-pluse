{
  "manifest_version": 3,
  "name": "افزونه سامانه های اداری مراکز مثبت زندگی",
  "short_name": "مثبت زندگی ۷۸۲۸",
  "version": "3.0.0",
  "description": "افزونه سامانه های اداری مراکز مثبت زندگی — طرح و ایده مهدی افشار مرکز مثبت زندگی 7828 سیرجان",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "افزونه سامانه های اداری مراکز مثبت زندگی",
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}